{
  "name": "@church-platform/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run --exclude test/database.integration.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "test:db": "vitest run test/database.integration.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pg": "8.23.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.2",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "6.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.0",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
