# Public local-development examples only. Never use these values in staging/production.
# Real .env and .env.* files are ignored and must never be committed.
# Compose has matching defaults; copying this file to .env is optional.
POSTGRES_DB=church_platform_dev
POSTGRES_USER=church_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432

# Host-based connection example. Update this if any PostgreSQL values change.
# This is the image's local bootstrap user, not the future restricted API role.
DATABASE_URL=postgresql://church_dev:local_dev_only@localhost:5432/church_platform_dev
