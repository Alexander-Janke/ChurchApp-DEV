{
  "name": "church-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json .prettierrc.json README.md infrastructure/docker/compose.dev.yml \"services/api/**/*.{ts,mts,json}\" \"apps/web/**/*.{ts,tsx,mjs,json,css}\" \"apps/admin/**/*.{ts,tsx,mjs,json,css}\" \"packages/**/*.{ts,mts,json}\" \"tests/e2e/**/*.{ts,mts,json}\"",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json .prettierrc.json README.md infrastructure/docker/compose.dev.yml \"services/api/**/*.{ts,mts,json}\" \"apps/web/**/*.{ts,tsx,mjs,json,css}\" \"apps/admin/**/*.{ts,tsx,mjs,json,css}\" \"packages/**/*.{ts,mts,json}\" \"tests/e2e/**/*.{ts,mts,json}\"",
    "db:up": "docker compose -f infrastructure/docker/compose.dev.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/compose.dev.yml down",
    "db:logs": "docker compose -f infrastructure/docker/compose.dev.yml logs --follow postgres",
    "db:status": "docker compose -f infrastructure/docker/compose.dev.yml ps",
    "api:dev": "pnpm --filter @church-platform/api dev",
    "api:build": "pnpm --filter @church-platform/api build",
    "api:start": "pnpm --filter @church-platform/api start",
    "api:test": "pnpm --filter @church-platform/api test",
    "api:typecheck": "pnpm --filter @church-platform/api typecheck",
    "db:generate": "pnpm --filter @church-platform/api db:generate",
    "db:migrate": "pnpm --filter @church-platform/api db:migrate",
    "db:check": "pnpm --filter @church-platform/api db:check",
    "api:test:db": "pnpm --filter @church-platform/api test:db",
    "contracts:build": "pnpm --filter @church-platform/contracts build",
    "contracts:typecheck": "pnpm --filter @church-platform/contracts typecheck",
    "contracts:test": "pnpm --filter @church-platform/contracts test",
    "e2e:test": "pnpm --filter @church-platform/e2e test",
    "e2e:typecheck": "pnpm --filter @church-platform/e2e typecheck",
    "e2e:install": "pnpm --filter @church-platform/e2e install:browsers",
    "web:dev": "pnpm --filter @church-platform/web dev",
    "web:build": "pnpm --filter @church-platform/web build",
    "web:start": "pnpm --filter @church-platform/web start",
    "web:typecheck": "pnpm --filter @church-platform/web typecheck",
    "web:test": "pnpm --filter @church-platform/web test",
    "web:lint": "pnpm --filter @church-platform/web lint",
    "admin:dev": "pnpm --filter @church-platform/admin dev",
    "admin:build": "pnpm --filter @church-platform/admin build",
    "admin:start": "pnpm --filter @church-platform/admin start",
    "admin:typecheck": "pnpm --filter @church-platform/admin typecheck",
    "admin:test": "pnpm --filter @church-platform/admin test",
    "admin:lint": "pnpm --filter @church-platform/admin lint"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
